# ═══════════════════════════════════════════════════════════════════════
# SOBERANO — configuração do SERVIDOR (não do navegador)
# ═══════════════════════════════════════════════════════════════════════
# Copie este arquivo para ".env" (sem o .example) e preencha.
# Estas variáveis são lidas pelo SERVIDOR (server/index.js) — NUNCA vão para o
# navegador. É por isso que a chave da IA agora é segura: ela mora só aqui.

# ── IA (OpenRouter) ────────────────────────────────────────────────────
# A chave fica no servidor. O jogador nunca a vê. Sem ela, o jogo roda em
# modo demonstração (textos locais, sem IA).
OPENROUTER_API_KEY=

# Modelo padrão. Pode ser trocado em runtime na área administrativa.
#   anthropic/claude-sonnet-4       (mais capaz)
#   anthropic/claude-3.5-sonnet     (equilibrado — padrão)
#   google/gemini-2.0-flash-001     (rápido/barato)
#   openai/gpt-4o-mini              (barato)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── ÁREA ADMINISTRATIVA ────────────────────────────────────────────────
# Senha do painel /admin (configura modelo, testa IA, vê uso). SEM esta senha,
# o painel fica trancado. Use algo forte — é a chave da sala de máquinas.
ADMIN_PASSWORD=

# ── BANCO DE DADOS ─────────────────────────────────────────────────────
# VAZIO em dev: sem isto, server/store.js grava num arquivo JSON local e o jogo roda
# sem banco nenhum. Em produção, cole aqui a string do Neon (https://neon.tech):
#   postgresql://user:senha@ep-xxx.us-east-2.aws.neon.tech/soberano?sslmode=require
# A tabela é criada sozinha no primeiro boot — não há passo de migração.
DATABASE_URL=

# ── FREIOS DE CUSTO DA IA ──────────────────────────────────────────────
# O proxy protege a CHAVE; estes protegem o ORÇAMENTO. São problemas diferentes: com a
# chave escondida ninguém a rouba, mas qualquer um pode chamar /api/ai/generate num laço
# e torrar seus créditos. Cada geração é uma chamada paga.
AI_LIMITE_POR_MINUTO=12
AI_TETO_DIARIO=600

# ── SERVIDOR ───────────────────────────────────────────────────────────
# Porta HTTP (o WebSocket sobe na mesma porta).
PORT=8787

# URL pública do jogo (usada como Referer no OpenRouter). Ex.: https://soberano.seudominio.com
PUBLIC_URL=http://localhost:8787
